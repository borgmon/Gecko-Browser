{
  "manifest_version": 2,
  "name": "GeckoBrowser Lite",
  "version": "1.2",
  "description": "Removes animations and expensive visual effects for smoother browsing on slow devices.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lite@geckobrowser"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "lite.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lite.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
