<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".MainActivity">


    <!-- Top bar: back | forward | address field (lock, url, reload) | tabs | bookmarks.
         Colours are applied from code for the light / dark / OLED themes. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarView"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/browserToolbar"
        app:contentInsetEnd="0dp"
        app:contentInsetLeft="0dp"
        app:contentInsetRight="0dp"
        app:contentInsetStart="0dp">

        <LinearLayout
            android:id="@+id/toolbarRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/browserBackButton"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/back"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_back" />

            <View
                android:id="@+id/toolbarDivider1"
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/browserToolbarBorder" />

            <ImageButton
                android:id="@+id/browserForwardButton"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/forward"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_forward" />

            <LinearLayout
                android:id="@+id/addressField"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/address_bar_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/sslIndicatorView"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/ssl_unknown"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ssl_lock" />

                <com.example.geckobrowser.UrlEditText
                    android:id="@+id/urlEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:ellipsize="end"
                    android:hint="@string/location_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:inputType="text|textUri"
                    android:paddingStart="2dp"
                    android:paddingLeft="2dp"
                    android:paddingEnd="2dp"
                    android:paddingRight="2dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/browserAddressText"
                    android:textColorHint="@color/browserAddressHint"
                    android:textColorHighlight="@color/browserAddressHighlight"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/reloadButton"
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/reload_page"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_reload" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/tabsButtonFrame"
                android:layout_width="46dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/tabsCountViewImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_toolbar_tabs" />

                <TextView
                    android:id="@+id/tabsCountView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/tabs"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:paddingRight="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/_0"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <View
                android:id="@+id/toolbarDivider2"
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/browserToolbarBorder" />

            <ImageButton
                android:id="@+id/bookmarksButton"
                android:layout_width="46dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/menu_bookmarks"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_toolbar_bookmarks" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/menu_hamburger"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>


    <ProgressBar
        android:id="@+id/pageProgressView"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignBottom="@id/toolbarView"
        android:progressDrawable="@drawable/browser_progress" />

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarView"
        tools:context=".MainActivity" />

    <!-- Address bar suggestions (history, bookmarks, search engine). -->
    <ListView
        android:id="@+id/suggestionsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbarView"
        android:visibility="gone" />


